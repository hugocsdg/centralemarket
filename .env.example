# Copia este archivo como .env.local y rellena los valores de tu proyecto de Supabase
# (Supabase → botón "Connect" o Project Settings → API Keys).
# Son valores PÚBLICOS. Nunca pongas aquí la secret key ni la service_role.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
